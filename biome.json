{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!public",
      "!components/ui",
      "!pnpm-lock.yaml",
      "!pnpm-workspace.yaml"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true,
      "cjkFriendlyEmphasis": true
    }
  },
  "tailwind": {
    "stylesheet": "./app/globals.css",
    "mergeFunctions": ["cn", "clsx", "cx", "tw"],
    "variantFunctions": ["cva"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn"
      },
      "correctness": {
        "noUndeclaredDependencies": "error",
        "noBeforeInteractiveScriptOutsideDocument": "error",
        "noNextAsyncClientComponent": "error"
      },
      "performance": {
        "noSyncScripts": "error"
      },
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"], "requireAscii": true }
        },
        "useConsistentArrayType": {
          "level": "warn",
          "options": { "syntax": "shorthand" }
        },
        "useConsistentTypeDefinitions": {
          "level": "warn",
          "options": { "style": "interface" }
        },
        "noNestedTernary": "warn"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noConsole": { "level": "warn", "options": { "allow": ["error", "warn"] } },
        "noImportCycles": "warn"
      },
      "nursery": {
        "useReactCompiler": "error",
        "useTailwindSortedClasses": "warn"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "components/person-jsonld.tsx",
        "components/faq-jsonld.tsx",
        "components/note-jsonld.tsx"
      ],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["app/\\[locale\\]/opengraph-image.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          }
        }
      }
    }
  ]
}
