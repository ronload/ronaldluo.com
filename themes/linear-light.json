  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8a8f98",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#26a148"
      }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape", "string.template.element"],
      "settings": {
        "foreground": "#1a9ba5"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.decimal",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "#d97a35"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#d97a35"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.trycatch",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#a855c2"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "keyword.operator.ternary"
      ],
      "settings": {
        "foreground": "#1a9ba5"
      }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage",
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.type",
        "storage.type.enum",
        "storage.modifier",
        "storage.modifier.async",
        "storage.modifier.extends"
      ],
      "settings": {
        "foreground": "#a855c2"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#5e6ad2"
      }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": {
        "foreground": "#1a1a1f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#c4841d"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.type.primitive",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#1a9ba5"
      }
    },
    {
      "name": "Interfaces",
      "scope": ["entity.name.type.interface", "entity.name.type.alias"],
      "settings": {
        "foreground": "#1a9ba5"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": {
        "foreground": "#1a1a1f"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.object.property",
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#1a1a1f"
      }
    },
    {
      "name": "This/self",
      "scope": ["variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": {
        "foreground": "#d93026",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#d93026"
      }
    },
    {
      "name": "Tag brackets",
      "scope": ["punctuation.definition.tag.begin", "punctuation.definition.tag.end"],
      "settings": {
        "foreground": "#6b6f76"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#c4841d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "meta.decorator entity.name.function",
        "meta.decorator punctuation.decorator"
      ],
      "settings": {
        "foreground": "#d97a35"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#6b6f76"
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#d93026"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#5e6ad2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#d97a35",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#a855c2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#5e6ad2"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.raw.inline", "markup.fenced_code"],
      "settings": {
        "foreground": "#26a148"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#6b6f76",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown lists",
      "scope": ["markup.list", "punctuation.definition.list"],
      "settings": {
        "foreground": "#1a9ba5"
      }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#5e6ad2"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#c4841d"
      }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css"],
      "settings": {
        "foreground": "#1a9ba5"
      }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.property-value.css"],
      "settings": {
        "foreground": "#d97a35"
      }
    },
    {
      "name": "CSS units",
      "scope": ["keyword.other.unit.css"],
      "settings": {
        "foreground": "#d93026"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#d93026",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#d97a35",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#26a148"
      }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {
        "foreground": "#d93026"
      }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#c4841d"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#1a9ba5",
    "type.declaration": "#1a9ba5",
