  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#585A5C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#F1ADE0"
      }
    },
    {
      "name": "Template string expressions",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": {
        "foreground": "#6b80d8"
      }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#d7ba7d"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.decimal",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "#b5cea8"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#6b80d8"
      }
    },
    {
      "name": "Constants",
      "scope": ["variable.other.constant", "variable.other.enummember"],
      "settings": {
        "foreground": "#94A8FF"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#58EBDD"
      }
    },
    {
      "name": "Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#58EBDD"
      }
    },
    {
      "name": "Imported names",
      "scope": ["variable.other.readwrite.alias", "meta.import variable.other.readwrite"],
      "settings": {
        "foreground": "#8FA4FF"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Special operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "keyword.operator.spread",
        "keyword.operator.rest"
      ],
      "settings": {
        "foreground": "#6b80d8"
      }
    },
    {
      "name": "Storage types",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#6b80d8"
      }
    },
    {
      "name": "Function/class storage",
      "scope": [
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.type",
        "storage.type.enum"
      ],
      "settings": {
        "foreground": "#6b80d8"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#FCC581"
      }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#8FA4FF"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#55CDFF"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#55CDFF"
      }
    },
    {
      "name": "Type parameters",
      "scope": ["entity.name.type.parameter"],
      "settings": {
        "foreground": "#55CDFF"
      }
    },
    {
      "name": "Primitive types",
      "scope": ["support.type.primitive"],
      "settings": {
        "foreground": "#55CDFF"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": {
        "foreground": "#8FA4FF"
      }
    },
    {
      "name": "Object properties",
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#8FA4FF"
      }
    },
    {
      "name": "This/self",
      "scope": ["variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": {
        "foreground": "#6b80d8"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#6b80d8"
      }
    },
    {
      "name": "JSX Component tags",
      "scope": ["support.class.component"],
      "settings": {
        "foreground": "#55CDFF"
      }
    },
    {
      "name": "Tag brackets",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#8FA4FF"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "meta.decorator entity.name.function",
        "meta.decorator punctuation.decorator"
      ],
      "settings": {
        "foreground": "#FCC581"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#d16969"
      }
    },
    {
      "name": "Regex character classes",
      "scope": [
        "constant.other.character-class.regexp",
        "constant.character.character-class.regexp"
      ],
      "settings": {
        "foreground": "#d16969"
      }
    },
    {
      "name": "Regex groups",
      "scope": ["punctuation.definition.group.regexp"],
      "settings": {
        "foreground": "#F1ADE0"
      }
    },
    {
      "name": "Regex quantifiers",
      "scope": ["keyword.operator.quantifier.regexp"],
      "settings": {
        "foreground": "#d7ba7d"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": {
        "foreground": "#6b80d8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#6b80d8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#6b80d8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#F1ADE0"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.raw.inline", "markup.fenced_code"],
      "settings": {
        "foreground": "#F1ADE0"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": ["markup.quote", "punctuation.definition.quote.begin.markdown"],
      "settings": {
        "foreground": "#585A5C"
      }
    },
    {
      "name": "Markdown lists",
      "scope": ["punctuation.definition.list.begin.markdown"],
      "settings": {
        "foreground": "#6796E6"
      }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#8FA4FF"
      }
    },
    {
      "name": "CSS tag selectors",
      "scope": ["entity.name.tag.css", "entity.name.tag.less", "entity.name.tag.scss"],
      "settings": {
        "foreground": "#d7ba7d"
      }
    },
    {
      "name": "CSS class/id selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#d7ba7d"
      }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "meta.property-name.css"],
      "settings": {
        "foreground": "#8FA4FF"
      }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.property-value.css", "meta.property-value.css"],
      "settings": {
        "foreground": "#F1ADE0"
      }
    },
    {
      "name": "CSS units",
      "scope": ["keyword.other.unit.css", "keyword.other.unit.scss", "keyword.other.unit.less"],
      "settings": {
        "foreground": "#b5cea8"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#ff9898"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#d7ba7d",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#b5cea8"
      }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {
        "foreground": "#F1ADE0"
      }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#6b80d8"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#55CDFF",
    "type.declaration": "#55CDFF",
    "type.defaultLibrary": "#55CDFF",
    "class": "#55CDFF",
    "class.declaration": "#55CDFF",
    "class.defaultLibrary": "#55CDFF",
    "interface": "#55CDFF",
    "interface.declaration": "#55CDFF",
    "enum": "#55CDFF",
    "enumMember": "#94A8FF",
    "function": "#FCC581",
    "function.declaration": "#FCC581",
    "function.defaultLibrary": "#FCC581",
    "method": "#FCC581",
    "method.declaration": "#FCC581",
    "method.defaultLibrary": "#FCC581",
    "parameter": "#8FA4FF",
    "property": "#8FA4FF",
    "property.readonly": "#8FA4FF",
    "property.declaration": "#8FA4FF",
    "variable": "#8FA4FF",
    "variable.declaration": "#8FA4FF",
    "variable.readonly": "#94A8FF",
    "variable.readonly.local": "#94A8FF",
    "variable.defaultLibrary": "#8FA4FF",
    "namespace": "#55CDFF",
    "macro": "#FCC581",
    "decorator": "#FCC581",
    "typeParameter": "#55CDFF"
  }
