    "postinstall": "fumadocs-mdx",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "lint": "biome check && eslint . && prettier --check \"content/**/*.md\" \"*.md\"",
    "format": "biome check --write && prettier --write \"content/**/*.md\" \"*.md\"",
    "validate": "pnpm typecheck && pnpm lint && pnpm notes:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^0.6.5",
    "fumadocs-core": "^16.12.1",
    "fumadocs-mdx": "^15.2.0",
    "lucide-react": "^1.25.0",
    "mermaid": "^11.16.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-cjk-friendly": "^2.3.1",
    "remark-join-cjk-lines": "^1.0.15",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
