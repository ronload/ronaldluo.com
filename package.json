{
  "name": "ronaldluo.com",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm notes:check && next build",
    "notes:check": "node scripts/check-notes.mjs",
    "analyze": "next experimental-analyze",
    "start": "next start",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
