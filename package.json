  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-biome": "^2.1.3",
    "eslint-config-next": "^16.2.10",
    "prettier": "^3.9.6",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
